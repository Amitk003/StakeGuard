# Copy this file to .env and fill in your own values.
# StakeGuard only needs an LLM key for the explanation layer.
# All risk math runs in plain Python code and never needs a key.

OPENAI_API_KEY=

# Optional. Point to any OpenAI-compatible endpoint
# (for example a local model server or a compatible provider).
OPENAI_BASE_URL=

# Optional. Model name to use for explanations.
LLM_MODEL=
